rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwnerOrAdmin(memberId) {
      return isAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/members/$(memberId)) && get(/databases/$(database)/documents/members/$(memberId)).data.authUid == request.auth.uid);
    }

    // Roles: readable only by matching uid or admin; never client-writable
    match /roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    // Members: admin full read/write; logged-in members read-only their own doc (matched by authUid)
    match /members/{memberId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.authUid == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payments: admin-only
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Workouts: admin read/write; matching member read-only
    match /workouts/{memberId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.memberId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}